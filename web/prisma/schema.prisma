// Wideline data model. Field names follow the PRD's Data model section.
//
// Tenancy (NFR-16): every model except the global ones (Organisation, User, the
// Better Auth tables and the scout tables) carries organisationId, Invitation
// included. Application code reaches the database only through the scoped
// client in src/server/db/scoped.ts, which injects organisationId into every
// query. See TENANT_SCOPED in that file and
// keep it in step with this schema.
//
// References between tenant tables are composite foreign keys on
// (organisationId, id), so the database itself refuses a row that points at
// another organisation's row.
//
// Scouts (AUTH08 to AUTH10): ScoutProfile and ScoutAffiliation are global and
// scout-owned, like User. They carry no organisationId and are never reachable
// from a scoped client (FORBIDDEN in scoped.ts). Only src/server/scouts/ (the
// caller's own userId) and src/server/platform/scouts.ts (platform_admin) touch
// them. An independent scout's role comes from a scout Membership in the one
// scout_network organisation, "Wideline scouts".
//
// Organisations start pending (ADMIN01): a platform admin approves or rejects
// them. The active organisation of a signed-in user is stored per session in
// Session.activeOrganisationId (AUTH05), a plain column with no relation, so a
// scoped Organisation read can never reach session tokens.
//
// Plans and entitlements (BILL01, BILL02, ADMIN04): Plan is global. Subscription
// (one per organisation), Entitlement (overrides and feature flags) and
// UsageEvent (the usage meter, ADMIN05, NFR04) carry organisationId but are
// refused by the scoped client, like the scout tables: only
// src/server/entitlements/, src/server/usage/meter.ts and
// src/server/platform/entitlements.ts touch them, always for one explicit
// organisation. Every limit is read through entitlement() / hasCapacity(),
// never from a constant.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // C04: the partial unique index on Player squad numbers (see Player).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisations and accounts
// ---------------------------------------------------------------------------

enum OrganisationType {
  academy
  club
  agency
  platform
  // AUTH08: the one shared organisation that holds independent scouts' scout
  // memberships (src/server/scouts/network.ts). No owners or admins.
  scout_network
}

enum OrganisationStatus {
  pending
  active
  suspended
  // ADMIN01: kept, not deleted, so the decision stays on record.
  rejected
}

// AUTH-03. analyst is merged into scout.
enum Role {
  owner
  admin
  coach
  scout
  agent
  player
  guardian
  platform_admin
}

model Organisation {
  id              String             @id @default(cuid())
  name            String
  type            OrganisationType
  country         String             @default("ZA")
  region          String?
  status          OrganisationStatus @default(pending)
  // ADMIN01: who applied through /apply, and the platform admin's decision.
  applicantName   String?
  applicantEmail  String?
  reviewedAt      DateTime?
  rejectionReason String?
  // REVIEW-10: auto-accept thresholds per event type, plus other per-org
  // settings. Shape is defined and defaulted in src/server/settings.ts.
  settings        Json               @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships Membership[]
  teams       Team[]
  players     Player[]
  matches     Match[]
  lineups     Lineup[]
  auditLogs   AuditLog[]
  invitations Invitation[]

  // Refused by the scoped client: it would reveal which scouts declared a
  // conflict with this organisation.
  scoutAffiliations ScoutAffiliation[]

  // Refused by the scoped client (ORG_PRIVATE_RELATIONS): plan data and the
  // platform admins' override notes are internal. Read them through
  // src/server/entitlements/.
  subscription Subscription?
  entitlements Entitlement[]
  usageEvents  UsageEvent[]
}

// Global. Columns match what Better Auth expects for its user model.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  memberships         Membership[] @relation("MembershipUser")
  invitations         Membership[] @relation("MembershipInvitedBy")
  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")
  // Refused by the scoped client (USER_PRIVATE_RELATIONS).
  scoutProfile        ScoutProfile?
}

// Better Auth: database sessions, so a session can be revoked server-side.
model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  // AUTH05: the organisation this session works in. No foreign key and no
  // relation on purpose (see the header). A stale value falls back to the
  // user's oldest active membership.
  activeOrganisationId String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

// Better Auth: one row per sign-in method. Passwords live here (providerId
// "credential"), hashed by Better Auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Better Auth: magic-link and other verification tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Membership {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role
  invitedById    String?
  invitedBy      User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organisationId, userId, role])
  @@index([userId])
}

// AUTH04: an email invitation with a role. The token is stored only as a
// sha256 hash; the raw token appears only in the email link. Accepting creates
// a Membership. Revoked and accepted rows are kept for the audit trail.
model Invitation {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  // Lowercased and trimmed.
  email            String
  inviteeName      String?
  role             Role
  tokenHash        String       @unique
  invitedById      String?
  invitedBy        User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  // 14 days after creation (AUTH04).
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedBy       User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, email])
  @@index([organisationId, createdAt])
}

// ---------------------------------------------------------------------------
// Scouts (AUTH08, AUTH09, AUTH10, ADMIN01, ADMIN06)
// ---------------------------------------------------------------------------

// rejected is kept alongside the PRD's pending, approved and suspended, so a
// decision stays on record, as for organisations.
enum ScoutStatus {
  pending
  approved
  rejected
  suspended
}

enum IdDocumentType {
  sa_id
  passport
}

enum ScoutAffiliationType {
  club
  player
}

// Global and scout-owned (see the header). The ID or passport number is never
// stored: only an HMAC-SHA256 of it (src/server/scouts/identity.ts), unique so
// one identity registers once.
model ScoutProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           ScoutStatus    @default(pending)
  idDocumentType   IdDocumentType
  // ISO 3166-1 alpha-2; ZA for a South African ID.
  idCountry        String
  idNumberHash     String         @unique
  // E.164.
  phone            String
  termsAcceptedAt  DateTime
  // REVIEWER_TERMS_VERSION at acceptance. Review access needs the current one.
  termsVersion     String
  // Set when a platform admin approves.
  verifiedAt       DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  rejectionReason  String?
  suspendedAt      DateTime?
  suspensionReason String?
  // Written by spot-checks (C18).
  accuracyScore    Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  affiliations ScoutAffiliation[]

  @@index([status, createdAt])
}

// AUTH10: a club the scout works for or with, or a player they represent, as
// declared (free text). A platform admin links it to a Wideline organisation;
// only linked rows block review claims (scoutConflicts, C10). Removal is soft
// (removedAt), so the history stays.
model ScoutAffiliation {
  id             String               @id @default(cuid())
  scoutUserId    String
  scout          ScoutProfile         @relation(fields: [scoutUserId], references: [userId], onDelete: Cascade)
  type           ScoutAffiliationType
  // The club name, or the player name, as declared.
  name           String
  // Player rows only: the player's club, as declared.
  clubName       String?
  // The linked Wideline club, or the represented player's club.
  organisationId String?
  organisation   Organisation?        @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  linkedAt       DateTime?
  linkedById     String?
  declaredAt     DateTime             @default(now())
  removedAt      DateTime?

  @@index([scoutUserId])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Squads
// ---------------------------------------------------------------------------

// One team in one season (SQUAD01). Names are unique per organisation and
// season, so "U15 Boys (2026)" names one team.
model Team {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  ageGroup       String?
  // A label only; no behaviour depends on it (SQUAD-01).
  gender         String?
  season         String
  // SQUAD07: a team the club plays against. It holds only unnamed placeholder
  // players (a shirt number, optionally a position), never named children from
  // another club. Set at creation and never changed (src/server/squad/teams.ts).
  isOpposition   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  lineups     Lineup[]

  @@unique([organisationId, id])
  @@unique([organisationId, name, season])
  @@index([organisationId])
}

enum ConsentState {
  none
  requested
  club_only
  scout_visible
  withdrawn
}

enum ClubStatus {
  active
  departed
}

enum PreferredFoot {
  left
  right
  both
}

model Player {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?          @relation(fields: [organisationId, teamId], references: [organisationId, id])
  // Names are optional: V0 Lab lineups use shirt-number placeholders only, so
  // no per-player data is derived about a named, non-consented child (NFR-08).
  firstName      String?
  lastName       String?
  // SQUAD-07: unnamed placeholder, e.g. an opposition player.
  isPlaceholder  Boolean        @default(false)
  dateOfBirth    DateTime?      @db.Date
  position       String?
  preferredFoot  PreferredFoot?
  heightCm       Int?
  squadNumber    Int?
  // Cached current state; the Consent table (later) is the source of truth.
  consentState   ConsentState   @default(none)
  // SQUAD09: departing sets clubStatus and departedAt only (markDeparted in
  // src/server/squad/players.ts). Nothing cascades: lineups, matches and stats
  // stay, and so does teamId, for history. A departed player is read-only to
  // the club and left out of ACTIVE_PLAYER (pickers and dashboards).
  clubStatus     ClubStatus     @default(active)
  departedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lineups Lineup[]

  @@unique([organisationId, id])
  // SQUAD04: a squad number is used once per team among active players. A Team
  // row is one season, so this is "per team per season"; a departed player
  // frees their number. Partial, so blank numbers and departed players are free.
  @@unique([organisationId, teamId, squadNumber], map: "Player_team_squadNumber_active_key", where: raw("\"squadNumber\" IS NOT NULL AND \"clubStatus\" = 'active'"))
  @@index([organisationId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Matches
// ---------------------------------------------------------------------------

enum MatchStatus {
  draft
  uploading
  processing
  awaiting_review
  in_review
  published
  failed
}

model Match {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  homeTeamId     String
  homeTeam       Team         @relation("HomeTeam", fields: [organisationId, homeTeamId], references: [organisationId, id])
  awayTeamId     String
  awayTeam       Team         @relation("AwayTeam", fields: [organisationId, awayTeamId], references: [organisationId, id])
  playedAt       DateTime
  venue          String?
  competition    String?
  status         MatchStatus  @default(draft)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lineups Lineup[]

  @@unique([organisationId, id])
  @@index([organisationId, playedAt])
}

model Lineup {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId        String
  match          Match        @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [organisationId, teamId], references: [organisationId, id])
  playerId       String
  player         Player       @relation(fields: [organisationId, playerId], references: [organisationId, id])
  shirtNumber    Int
  position       String?
  isStarter      Boolean      @default(true)
  // Match seconds the player came on and went off (SQUAD-06). startedAt is 0
  // for starters; endedAt is null if they finished the match.
  startedAt      Int?
  endedAt        Int?

  @@unique([matchId, playerId])
  @@unique([matchId, teamId, shirtNumber])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Plans, entitlements and usage (BILL01, BILL02, ADMIN04, ADMIN05, NFR04)
// ---------------------------------------------------------------------------

// Global. limits is a JSON map keyed by the registry keys in
// src/lib/entitlement-keys.ts: a limit is a non-negative integer or
// "unlimited", a feature is a boolean. A key the plan lacks falls back to the
// registry. Only the pilot plan exists in v0 (seeded by the c03 migration).
model Plan {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  priceCents Int      @default(0)
  // ISO 4217.
  currency   String   @default("ZAR")
  limits     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  // Data is never deleted when a subscription lapses; it becomes read-only (V201).
  lapsed
}

// One per organisation. A plan change updates the row and is audited; the
// history lives in AuditLog. provider and providerRef stay null until V201.
model Subscription {
  id               String             @id @default(cuid())
  organisationId   String             @unique
  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus @default(active)
  provider         String?
  providerRef      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([organisationId, id])
}

enum EntitlementSource {
  // A per-organisation limit (or add-on) that beats the plan.
  override
  // A per-organisation feature flag: the last word (ADMIN04).
  flag
}

// Per-organisation overrides and feature flags, resolved over the plan by
// src/server/entitlements/resolve.ts. key is a plain string, not an enum, so a
// new registry key needs no migration. value is JSON in the registry's shape.
// reason is a platform admin's internal note. setByUserId is a plain column with
// no User relation, so the row never reaches a user record.
model Entitlement {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key            String
  source         EntitlementSource
  value          Json
  reason         String?
  setByUserId    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organisationId, key, source])
  @@unique([organisationId, id])
}

enum UsageMetric {
  matches
  // Minutes are stored as seconds and shown as minutes (C18).
  video_seconds
  // In cents of the currency the provider bills; see UsageEvent.currency.
  gpu_cost_cents
  storage_bytes
}

// The usage meter (ADMIN05, NFR04): one signed delta per source. Storage
// deletions are negative rows, so current storage is the sum. Written only by
// recordUsage() (src/server/usage/meter.ts); the unique key makes a retried job
// count once (NFR06).
model UsageEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  metric         UsageMetric
  quantity       BigInt
  // ISO 4217, gpu_cost_cents only.
  currency       String?
  // What produced the usage, e.g. "Match" or "CvJob", and its id.
  sourceType     String
  sourceId       String
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([organisationId, metric, sourceType, sourceId])
  @@unique([organisationId, id])
  @@index([organisationId, metric, occurredAt])
}

// ---------------------------------------------------------------------------
// Audit (AUTH-07, NFR-20)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(cuid())
  // Null for platform-level events such as a login, which belong to a user,
  // not an organisation.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
}
