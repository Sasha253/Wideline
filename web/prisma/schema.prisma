// Wideline data model. Field names follow the PRD's Data model section.
//
// Tenancy (NFR-16): every model except the global ones (Organisation, User, the
// Better Auth tables and the scout tables) carries organisationId, Invitation
// included. Application code reaches the database only through the scoped
// client in src/server/db/scoped.ts, which injects organisationId into every
// query. See TENANT_SCOPED in that file and
// keep it in step with this schema.
//
// References between tenant tables are composite foreign keys on
// (organisationId, id), so the database itself refuses a row that points at
// another organisation's row.
//
// Scouts (AUTH08 to AUTH10): ScoutProfile and ScoutAffiliation are global and
// scout-owned, like User. They carry no organisationId and are never reachable
// from a scoped client (FORBIDDEN in scoped.ts). Only src/server/scouts/ (the
// caller's own userId) and src/server/platform/scouts.ts (platform_admin) touch
// them. An independent scout's role comes from a scout Membership in the one
// scout_network organisation, "Wideline scouts".
//
// Organisations start pending (ADMIN01): a platform admin approves or rejects
// them. The active organisation of a signed-in user is stored per session in
// Session.activeOrganisationId (AUTH05), a plain column with no relation, so a
// scoped Organisation read can never reach session tokens.
//
// Plans and entitlements (BILL01, BILL02, ADMIN04): Plan is global. Subscription
// (one per organisation), Entitlement (overrides and feature flags) and
// UsageEvent (the usage meter, ADMIN05, NFR04) carry organisationId but are
// refused by the scoped client, like the scout tables: only
// src/server/entitlements/, src/server/usage/meter.ts and
// src/server/platform/entitlements.ts touch them, always for one explicit
// organisation. Every limit is read through entitlement() / hasCapacity(),
// never from a constant.
//
// Matches and footage (C06): Video is a tenant table like Match and Lineup, in
// TENANT_SCOPED. Its raw file lives in object storage under
// orgs/{organisationId}/matches/{matchId}/; only the retention worker
// (src/worker/retention.ts) deletes it (NFR32).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // C04: the partial unique index on Player squad numbers (see Player); C06:
  // one live Video per match (see Video); C07: one transcode job per video
  // (see ProcessingJob).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisations and accounts
// ---------------------------------------------------------------------------

enum OrganisationType {
  academy
  club
  agency
  platform
  // AUTH08: the one shared organisation that holds independent scouts' scout
  // memberships (src/server/scouts/network.ts). No owners or admins.
  scout_network
}

enum OrganisationStatus {
  pending
  active
  suspended
  // ADMIN01: kept, not deleted, so the decision stays on record.
  rejected
}

// AUTH-03. analyst is merged into scout.
enum Role {
  owner
  admin
  coach
  scout
  agent
  player
  guardian
  platform_admin
}

model Organisation {
  id              String             @id @default(cuid())
  name            String
  type            OrganisationType
  country         String             @default("ZA")
  region          String?
  status          OrganisationStatus @default(pending)
  // ADMIN01: who applied through /apply, and the platform admin's decision.
  applicantName   String?
  applicantEmail  String?
  reviewedAt      DateTime?
  rejectionReason String?
  // REVIEW-10: auto-accept thresholds per event type under settings.autoAccept
  // ({ goal?, shot? }, read by autoAcceptThresholds() in
  // src/lib/auto-accept.ts), plus other per-org settings.
  settings        Json               @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships       Membership[]
  teams             Team[]
  players           Player[]
  matches           Match[]
  lineups           Lineup[]
  auditLogs         AuditLog[]
  invitations       Invitation[]
  // C05: consent records and guardian links (CONS01 to CONS04).
  consents          Consent[]
  consentRequests   ConsentRequest[]
  // C06: match footage (MATCH02 to MATCH05).
  videos            Video[]
  // C07: transcode, clips and CV jobs (MATCH06, NFR31).
  processingJobs    ProcessingJob[]
  // C08: CV output (CV01, CV09; NFR08 gate at ingest).
  tracks            Track[]
  trackPoints       TrackPoint[]
  events            Event[]
  // C09: clips (CV11), favourites (the clip's organisation), pitch
  // calibrations (CV05) and Lab ground truth.
  clips             Clip[]
  clipFavourites    ClipFavourite[]
  pitchCalibrations PitchCalibration[]
  benchmarkTags     BenchmarkTag[]

  // Refused by the scoped client: it would reveal which scouts declared a
  // conflict with this organisation.
  scoutAffiliations ScoutAffiliation[]

  // Refused by the scoped client (ORG_PRIVATE_RELATIONS): plan data and the
  // platform admins' override notes are internal. Read them through
  // src/server/entitlements/.
  subscription Subscription?
  entitlements Entitlement[]
  usageEvents  UsageEvent[]
  // C08: GPU instances and their cost are internal (src/server/cv/).
  gpuInstances GpuInstance[]
}

// Global. Columns match what Better Auth expects for its user model.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions               Session[]
  accounts               Account[]
  memberships            Membership[]     @relation("MembershipUser")
  invitations            Membership[]     @relation("MembershipInvitedBy")
  invitationsSent        Invitation[]     @relation("InvitationInvitedBy")
  invitationsAccepted    Invitation[]     @relation("InvitationAcceptedBy")
  // Refused by the scoped client (USER_PRIVATE_RELATIONS).
  scoutProfile           ScoutProfile?
  // C05. Refused by the scoped client (USER_PRIVATE_RELATIONS): they would list
  // every consent a user recorded or requested, in any organisation.
  consentsRecorded       Consent[]        @relation("ConsentRecordedBy")
  consentRequestsCreated ConsentRequest[] @relation("ConsentRequestCreatedBy")
  // C09. Refused by the scoped client (USER_PRIVATE_RELATIONS): a scout's
  // favourites span organisations.
  clipFavourites         ClipFavourite[]
}

// Better Auth: database sessions, so a session can be revoked server-side.
model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  // AUTH05: the organisation this session works in. No foreign key and no
  // relation on purpose (see the header). A stale value falls back to the
  // user's oldest active membership.
  activeOrganisationId String?
  // The platform admin who opened this session with "Log in as"
  // (src/server/auth/impersonation.ts). No relation, like activeOrganisationId.
  impersonatedBy       String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

// Better Auth: one row per sign-in method. Passwords live here (providerId
// "credential"), hashed by Better Auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Better Auth: magic-link and other verification tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Membership {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role
  invitedById    String?
  invitedBy      User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organisationId, userId, role])
  @@index([userId])
}

// AUTH04: an email invitation with a role. The token is stored only as a
// sha256 hash; the raw token appears only in the email link. Accepting creates
// a Membership. Revoked and accepted rows are kept for the audit trail.
model Invitation {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  // Lowercased and trimmed.
  email            String
  inviteeName      String?
  role             Role
  tokenHash        String       @unique
  invitedById      String?
  invitedBy        User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  // 14 days after creation (AUTH04).
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedBy       User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, email])
  @@index([organisationId, createdAt])
}

// ---------------------------------------------------------------------------
// Scouts (AUTH08, AUTH09, AUTH10, ADMIN01, ADMIN06)
// ---------------------------------------------------------------------------

// rejected is kept alongside the PRD's pending, approved and suspended, so a
// decision stays on record, as for organisations.
enum ScoutStatus {
  pending
  approved
  rejected
  suspended
}

enum IdDocumentType {
  sa_id
  passport
}

enum ScoutAffiliationType {
  club
  player
}

// Global and scout-owned (see the header). The ID or passport number is never
// stored: only an HMAC-SHA256 of it (src/server/scouts/identity.ts), unique so
// one identity registers once.
model ScoutProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           ScoutStatus    @default(pending)
  idDocumentType   IdDocumentType
  // ISO 3166-1 alpha-2; ZA for a South African ID.
  idCountry        String
  idNumberHash     String         @unique
  // E.164.
  phone            String
  termsAcceptedAt  DateTime
  // REVIEWER_TERMS_VERSION at acceptance. Review access needs the current one.
  termsVersion     String
  // Set when a platform admin approves.
  verifiedAt       DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  rejectionReason  String?
  suspendedAt      DateTime?
  suspensionReason String?
  // Written by spot-checks (C18).
  accuracyScore    Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  affiliations ScoutAffiliation[]

  @@index([status, createdAt])
}

// AUTH10: a club the scout works for or with, or a player they represent, as
// declared (free text). A platform admin links it to a Wideline organisation;
// only linked rows block review claims (scoutConflicts, C10). Removal is soft
// (removedAt), so the history stays.
model ScoutAffiliation {
  id             String               @id @default(cuid())
  scoutUserId    String
  scout          ScoutProfile         @relation(fields: [scoutUserId], references: [userId], onDelete: Cascade)
  type           ScoutAffiliationType
  // The club name, or the player name, as declared.
  name           String
  // Player rows only: the player's club, as declared.
  clubName       String?
  // The linked Wideline club, or the represented player's club.
  organisationId String?
  organisation   Organisation?        @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  linkedAt       DateTime?
  linkedById     String?
  declaredAt     DateTime             @default(now())
  removedAt      DateTime?

  @@index([scoutUserId])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Squads
// ---------------------------------------------------------------------------

// One team in one season (SQUAD01). Names are unique per organisation and
// season, so "U15 Boys (2026)" names one team.
model Team {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  ageGroup       String?
  // A label only; no behaviour depends on it (SQUAD-01).
  gender         String?
  season         String
  // SQUAD07: a team the club plays against. It holds only unnamed placeholder
  // players (a shirt number, optionally a position), never named children from
  // another club. Set at creation and never changed (src/server/squad/teams.ts).
  isOpposition   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  lineups     Lineup[]

  @@unique([organisationId, id])
  // SQUAD01: a team name is unique per organisation and season, ignoring case.
  // Prisma cannot express an expression index, so the unique index
  // "Team_organisationId_lower_name_season_key" on ("organisationId",
  // lower("name"), "season") lives in raw SQL only (migration
  // 20261024093500_c04_squad_rules). teams.ts checks it first for the message.
  @@index([organisationId])
}

enum ConsentState {
  none
  requested
  club_only
  scout_visible
  withdrawn
}

enum ClubStatus {
  active
  departed
}

enum PreferredFoot {
  left
  right
  both
}

model Player {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?          @relation(fields: [organisationId, teamId], references: [organisationId, id])
  // Names are optional: V0 Lab lineups use shirt-number placeholders only, so
  // no per-player data is derived about a named, non-consented child (NFR-08).
  firstName      String?
  lastName       String?
  // SQUAD-07: unnamed placeholder, e.g. an opposition player.
  isPlaceholder  Boolean        @default(false)
  dateOfBirth    DateTime?      @db.Date
  position       String?
  preferredFoot  PreferredFoot?
  heightCm       Int?
  squadNumber    Int?
  // CONS01: a cache of the newest Consent row's state. Only the database writes
  // it: the BEFORE INSERT trigger "Consent_before_insert" sets it in the same
  // statement as the Consent insert, and "Player_consentState_guard" refuses
  // any other change (a new player must start at none). The scoped client also
  // refuses it in Player writes. Read visibility through consentVisibleTo()
  // (src/server/consent/visibility.ts), never by comparing this by hand.
  consentState   ConsentState   @default(none)
  // SQUAD09: departing sets clubStatus and departedAt only (markDeparted in
  // src/server/squad/players.ts). Nothing cascades: lineups, matches and stats
  // stay, and so does teamId, for history. A departed player is read-only to
  // the club and left out of ACTIVE_PLAYER (pickers and dashboards).
  clubStatus     ClubStatus     @default(active)
  departedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lineups         Lineup[]
  consents        Consent[]
  consentRequests ConsentRequest[]
  // C08: tracks linked to the player, and events attributed to them. Only
  // players passing attributablePlayerIds() are ever linked (NFR08).
  tracks          Track[]
  events          Event[]

  @@unique([organisationId, id])
  // SQUAD04: a squad number is used once per team among active players. A Team
  // row is one season, so this is "per team per season"; a departed player
  // frees their number. Partial, so blank numbers and departed players are free.
  // A squad number needs a team: CHECK "Player_squadNumber_needs_team" in raw
  // SQL ("squadNumber" IS NULL OR "teamId" IS NOT NULL; migration
  // 20261024093500_c04_squad_rules), so the index below always applies.
  @@unique([organisationId, teamId, squadNumber], map: "Player_team_squadNumber_active_key", where: raw("\"squadNumber\" IS NOT NULL AND \"clubStatus\" = 'active'"))
  @@index([organisationId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Consent (CONS01 to CONS04, NFR08 to NFR12; docs/build/design/C05.md)
// ---------------------------------------------------------------------------

// How the decision reached the club. guardian_link is set only by the guardian
// screens (/consent/[token]); email is for CONS05 (v1) and paper forms.
enum ConsentMethod {
  paper_form
  in_person
  guardian_link
  email
}

// Who decided, relative to the player. self only when the player was 18 or
// over on the decision date (CHECK "Consent_minor_needs_guardian").
enum ConsentRelationship {
  self
  parent
  legal_guardian
  grandparent
  other_relative
}

// Append-only (PRD "Rules the schema must enforce"): one row per decision,
// request or withdrawal, never edited or deleted. The current state is the
// newest row by createdAt, cached in Player.consentState by the trigger
// "Consent_before_insert" in the same statement. The rules live in Postgres,
// in raw SQL (migration c05_consent), because Prisma cannot declare them:
//  - CHECK "Consent_state_matches_choices": scout_visible is club and scouts
//    yes; club_only is club yes, scouts no; none, requested and withdrawn are
//    both no (NFR10).
//  - CHECK "Consent_scout_needs_club": scouts yes needs club yes.
//  - CHECK "Consent_grant_complete": a granting row names who decided, their
//    relationship, the method, the wording version and the date (NFR09).
//  - CHECK "Consent_minor_needs_guardian": a grant for a player under 18 on
//    the decision date comes from a guardian, never "self" (CONS02).
//  - CHECK "Consent_withdrawn_has_time": a withdrawn row has withdrawnAt.
//  - Trigger "Consent_append_only": UPDATE and DELETE raise, apart from the
//    cascades (organisation or player deleted) and the recordedById SetNull
//    when a user is deleted, which run inside another trigger.
//  - Trigger "Consent_before_insert": refuses placeholder and opposition
//    players, writes Player.consentState (locking the player row, so changes
//    to one player serialise) and stamps a strictly increasing createdAt.
// Names (grantedBy) are children's and guardians' data: shown on screen only,
// never in audit metadata or logs.
model Consent {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player               @relation(fields: [organisationId, playerId], references: [organisationId, id], onDelete: Cascade)
  state          ConsentState
  // NFR10: the two separate choices.
  clubStats      Boolean
  scoutVisible   Boolean
  // Who decided (or, for a withdrawal, who asked): a guardian's or the
  // player's own name as given.
  grantedBy      String?
  relationship   ConsentRelationship?
  method         ConsentMethod?
  // CONSENT_WORDING_VERSION shown to the person deciding
  // (src/server/consent/wording.ts).
  wordingVersion String?
  // Under 18 on the decision date (Africa/Johannesburg), or no date of birth.
  playerWasMinor Boolean
  // The decision date, for grants and refusals.
  grantedAt      DateTime?
  withdrawnAt    DateTime?
  // The club user who recorded it; null when the guardian decided through a
  // link, or the user was deleted.
  recordedById   String?
  recordedBy     User?                @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  // The guardian link it came through, if any. A composite foreign key, so a
  // row can only point at a link of its own organisation (NFR16). NoAction on
  // delete: links are never deleted on their own, only by the same organisation
  // or player cascade that deletes this row (migration c05_consent_request_fk).
  requestId      String?
  request        ConsentRequest?      @relation(fields: [organisationId, requestId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  // V104: a scan of a signed paper form, in private storage. Unused in v0.
  evidencePath   String?
  // Set by the trigger: clock_timestamp() in UTC, or the player's newest row
  // plus 1 ms, so one player's rows are strictly ordered (migration
  // c05_consent_order).
  createdAt      DateTime             @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, playerId, createdAt])
}

// A guardian consent link (/consent/<token>). Only a sha256 hash of the token
// is stored; the raw URL is shown to the club once. One open link per player:
// a new one revokes the others. A link decides for 14 days; after that, and
// until it is revoked or replaced, it can still withdraw (NFR11: withdrawing
// is as easy as granting).
model ConsentRequest {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player       @relation(fields: [organisationId, playerId], references: [organisationId, id], onDelete: Cascade)
  tokenHash      String       @unique
  createdById    String?
  createdBy      User?        @relation("ConsentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  /// The guardian's email address, when the club asked Wideline to email the
  /// link (Q-019). Personal data: never in AuditLog metadata or logs.
  guardianEmail  String?
  consents       Consent[]

  @@unique([organisationId, id])
  @@index([organisationId, playerId])
}

// ---------------------------------------------------------------------------
// Matches
// ---------------------------------------------------------------------------

enum MatchStatus {
  draft
  uploading
  processing
  awaiting_review
  in_review
  published
  failed
}

model Match {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  homeTeamId        String
  homeTeam          Team         @relation("HomeTeam", fields: [organisationId, homeTeamId], references: [organisationId, id])
  awayTeamId        String
  awayTeam          Team         @relation("AwayTeam", fields: [organisationId, awayTeamId], references: [organisationId, id])
  playedAt          DateTime
  venue             String?
  competition       String?
  status            MatchStatus  @default(draft)
  // C06: minutes in each half; the match is 2 x this long. Youth age groups
  // play shorter halves. CHECK "Match_halfLength_range" (10 to 60) and
  // "Match_home_ne_away" live in raw SQL (migration c06_matches_rules).
  halfLengthMinutes Int          @default(45)
  // A plain column, no relation: the match outlives the user.
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  lineups        Lineup[]
  videos         Video[]
  // C07: one job per video and type: transcode (C07), cv (C08), clips (C09).
  processingJobs ProcessingJob[]
  // C08: CV output.
  tracks         Track[]
  trackPoints    TrackPoint[]
  events         Event[]
  // C09: clips (CV11) and Lab ground truth (BenchmarkTag).
  clips          Clip[]
  benchmarkTags  BenchmarkTag[]

  @@unique([organisationId, id])
  @@index([organisationId, playedAt])
}

model Lineup {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId          String
  match            Match        @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  teamId           String
  team             Team         @relation(fields: [organisationId, teamId], references: [organisationId, id])
  playerId         String
  player           Player       @relation(fields: [organisationId, playerId], references: [organisationId, id])
  // SQUAD04: may differ from Player.squadNumber; it is what the player wore in
  // this match.
  shirtNumber      Int
  position         String?
  isStarter        Boolean      @default(true)
  // Match seconds the player came on and went off (SQUAD-06). startedAt is 0
  // for starters and null for a substitute who never came on; endedAt is null
  // if they finished the match. CHECK "Lineup_times_valid" in raw SQL.
  startedAt        Int?
  endedAt          Int?
  // C06 (SQUAD06): the row this substitute replaced. A composite self-relation,
  // so it can only point inside the organisation. NoAction: lineups.ts clears
  // links before deleting a row; a match deletion removes both in one statement.
  replacesLineupId String?
  replacesLineup   Lineup?      @relation("LineupReplaces", fields: [organisationId, replacesLineupId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  replacedBy       Lineup[]     @relation("LineupReplaces")

  @@unique([organisationId, id])
  @@unique([matchId, playerId])
  @@unique([matchId, teamId, shirtNumber])
  @@index([organisationId])
}

// C06 (MATCH02, MATCH03, MATCH07): one upload of a match recording.
enum VideoStatus {
  // The browser is sending parts (S3 multipart upload s3UploadId is open).
  uploading
  // Uploaded; the worker's ffprobe check is running.
  probing
  accepted
  // Failed the footage rules. The file stays until rawExpiresAt (NFR32).
  rejected
  // The club cancelled the upload; the multipart upload was aborted.
  cancelled
}

// One match recording. A match has at most one live video (uploading, probing
// or accepted: the partial unique index "Video_match_live_key"); rejected and
// cancelled attempts stay as rows for history. The record survives deletion of
// the file (deletedAt), so its metadata stays (PRD data model).
//
// Raw SQL (migration c06_matches_rules): CHECK "Video_size_positive" and
// "Video_markers_ordered" (kickoff < half-time <= second-half kickoff < full
// time, among those set, all >= 0).
model Video {
  id                  String            @id @default(cuid())
  organisationId      String
  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId             String
  match               Match             @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  status              VideoStatus       @default(uploading)
  // Object key of the raw file: orgs/{organisationId}/matches/{matchId}/raw/{id}.{ext}.
  blobPath            String
  // As chosen in the browser. Shown to the club; never in logs or audit rows.
  fileName            String
  contentType         String
  sizeBytes           BigInt
  // Bytes per multipart part (src/lib/upload/part-plan.ts); the last part is shorter.
  partSize            Int
  // The open S3 multipart upload, while uploading.
  s3UploadId          String?
  // sha256 of name|size|lastModified, so the same file resumes (NFR26).
  fingerprint         String
  // A plain column, no relation.
  uploadedByUserId    String?
  uploadStartedAt     DateTime          @default(now())
  uploadedAt          DateTime?
  // uploadedAt + 7 days (MATCH07). C17's retention job deletes the raw file then.
  rawExpiresAt        DateTime?
  // From ffprobe (src/server/matches/probe.ts). width and height are the
  // display size, after rotation.
  probedAt            DateTime?
  durationSec         Float?
  width               Int?
  height              Int?
  fps                 Float?
  codec               String?
  rotation            Int?
  // evaluateFootage() result: { verdict, issues[] } (src/lib/footage-rules.ts).
  validation          Json              @default("{}")
  // MATCH05, the four half-time offsets: video milliseconds of kickoff,
  // half-time, second-half kickoff and full time.
  kickoffMs           Int?
  halfTimeMs          Int?
  secondHalfKickoffMs Int?
  fullTimeMs          Int?
  // C07: object key of the HLS master playlist,
  // orgs/{organisationId}/matches/{matchId}/hls/{id}/master.m3u8. Set by the
  // transcode worker once every rendition is uploaded.
  hlsManifestPath     String?
  // Set when the raw file is deleted (C17).
  deletedAt           DateTime?
  // C09 (CV05): the calibration the match's stored positions are in. Set at
  // ingest (the venue's manual calibration, or a fallback made from this
  // video) and when a platform admin calibrates in the Lab.
  pitchCalibrationId  String?
  pitchCalibration    PitchCalibration? @relation(fields: [organisationId, pitchCalibrationId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  processingJobs ProcessingJob[]

  @@unique([organisationId, id])
  // Written as Postgres stores it (IN becomes = ANY), so migrate diff stays empty.
  @@unique([matchId], map: "Video_match_live_key", where: raw("status = ANY (ARRAY['uploading'::\"VideoStatus\", 'probing'::\"VideoStatus\", 'accepted'::\"VideoStatus\"])"))
  @@index([organisationId])
  @@index([matchId])
}

enum ProcessingJobType {
  // C07: raw footage to the HLS ladder (MATCH06).
  transcode
  // C09: event clips.
  clips
  // C08: the GPU computer-vision run.
  cv
}

enum ProcessingJobStatus {
  queued
  running
  succeeded
  failed
}

// C07 (MATCH06, NFR31): one row per processing job, so its state, attempts,
// timings and last error are queryable; the structured log carries its full
// history (src/server/processing/jobs.ts). pg-boss runs the job under
// bossJobId, created with the row, so sending it again is a no-op. Tenant
// table: in TENANT_SCOPED. CHECKs "ProcessingJob_attempts_range",
// "ProcessingJob_times_ordered" and "ProcessingJob_failed_has_error" live in
// raw SQL (migration c07_processing_jobs).
model ProcessingJob {
  id             String              @id @default(cuid())
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId        String
  match          Match               @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  videoId        String?
  video          Video?              @relation(fields: [organisationId, videoId], references: [organisationId, id], onDelete: Cascade)
  type           ProcessingJobType
  status         ProcessingJobStatus @default(queued)
  bossJobId      String              @unique @db.Uuid
  // Attempts started so far; pg-boss retries up to maxAttempts (NFR30).
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  queuedAt       DateTime            @default(now())
  startedAt      DateTime?
  lastAttemptAt  DateTime?
  finishedAt     DateTime?
  // Redacted (no signed URLs) and at most 500 characters. Never shown to a club.
  errorMessage   String?
  // Transcode: renditions (bytes, segments), encodeMs, uploadMs, realtimeFactor.
  // CV (C08): resultKey, resultSha256, schemaVersion, modelVersions, warnings,
  // counts, thresholds, realtimeFactor. Counts and ids only, never player ids.
  metadata       Json                @default("{}")
  // PRD columns for the C08 CV job (NFR04). costCents is the sum over the
  // job's GpuInstance rows, failed attempts included.
  modelVersion   String?
  gpuProvider    String?
  costCents      Int?
  // C08 (NFR30): set when platform admins were told of the final failure, so
  // they are told once (src/server/processing/alerts.ts).
  alertedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tracks Track[]
  events Event[]
  // C09: the clips a clips job cut.
  clips  Clip[]

  @@unique([organisationId, id])
  // One job per video and type (C08; C07 had a transcode-only partial unique).
  // CV re-runs (CV14, V202) will revisit this.
  @@unique([videoId, type], map: "ProcessingJob_video_type_key")
  @@index([organisationId, matchId])
  @@index([type, status, finishedAt])
}

// ---------------------------------------------------------------------------
// CV output (C08; CV01, CV09, CV10, NFR04, NFR06, NFR07, NFR08)
// ---------------------------------------------------------------------------

enum TeamSide {
  home
  away
  unknown
}

// Who linked a track to a player: the CV ingest (shirt number) or a reviewer (C11).
enum TrackLinkSource {
  cv
  reviewer
}

// v0 event types (the stats catalogue). Shot on target is Event.onTarget.
// Passes and the rest arrive as new values with a new contract version (V101).
enum EventType {
  goal
  shot
  touch
}

// PRD data model. C08 writes auto_accepted and pending_review only; review
// (C11) moves events to confirmed or rejected and adds manual ones.
enum EventStatus {
  auto_accepted
  pending_review
  confirmed
  rejected
  manual
}

// One tracked person in one CV result. Keyed on (jobId, trackIndex), so a
// re-ingest of the same result writes nothing twice (NFR06). playerId is set
// only for a player who passed attributablePlayerIds() at ingest (NFR08);
// tracks of other lineup players are never stored. Tenant table: in
// TENANT_SCOPED.
model Track {
  id              String           @id @default(cuid())
  organisationId  String
  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId         String
  match           Match            @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  // The cv ProcessingJob whose result this came from.
  jobId           String
  job             ProcessingJob    @relation(fields: [organisationId, jobId], references: [organisationId, id], onDelete: Cascade)
  trackIndex      Int
  teamSide        TeamSide
  shirtNumber     Int?
  shirtConfidence Float?
  playerId        String?
  player          Player?          @relation(fields: [organisationId, playerId], references: [organisationId, id], onDelete: Cascade)
  linkConfidence  Float?
  // C09 (CV08): metres covered, from distanceCovered() in src/lib/positions.ts
  // at ingest; recomputed when the match is re-projected. Orientation-free.
  // CHECK "Track_distance_nonneg" in raw SQL.
  distanceM       Float?
  linkedBy        TrackLinkSource?
  // A plain column, no relation (C11 reviewer links).
  linkedByUserId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  points TrackPoint[]
  events Event[]

  @@unique([organisationId, id])
  @@unique([jobId, trackIndex])
  @@index([organisationId, matchId])
  @@index([playerId])
}

// A track's position at one sampled frame, in metres on the 105 x 68 pitch.
// Partitioned in raw SQL (migration c08_cv_ingest): PARTITION BY HASH
// ("matchId"), 16 partitions in schema trackpoint_parts, so Prisma sees only
// this parent. The partition key is in the primary key, which is also the
// idempotency key. CHECK "TrackPoint_coords" in raw SQL.
model TrackPoint {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId        String
  match          Match        @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  trackId        String
  track          Track        @relation(fields: [organisationId, trackId], references: [organisationId, id], onDelete: Cascade)
  // Video milliseconds.
  tMs            Int
  x              Float        @db.Real
  y              Float        @db.Real

  @@id([matchId, trackId, tMs])
}

// One detected (or, from C11, manually added) event. A CV event's identity in
// its result is (jobId, sourceKey), "{type}@{tMs}#{trackIndex|none}", so a
// re-ingest writes nothing twice (NFR06). Times are video ms, mapped to the
// match clock at read (src/lib/match-clock.ts). Raw SQL CHECKs (migration
// c08_cv_ingest): "Event_confidence_range", "Event_coords",
// "Event_clip_window", "Event_player_needs_track" (playerId only on a linked
// track, or a manual event) and "Event_cv_has_identity". Tenant table.
model Event {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId        String
  match          Match          @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  // Null for a manual event (C11). Jobs only go with their match, which
  // cascades the events first.
  jobId          String?
  job            ProcessingJob? @relation(fields: [organisationId, jobId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  sourceKey      String?
  type           EventType
  status         EventStatus
  teamSide       TeamSide?
  trackId        String?
  track          Track?         @relation(fields: [organisationId, trackId], references: [organisationId, id], onDelete: Cascade)
  playerId       String?
  player         Player?        @relation(fields: [organisationId, playerId], references: [organisationId, id], onDelete: Cascade)
  timestampMs    Int
  pitchX         Float?
  pitchY         Float?
  confidence     Float?
  onTarget       Boolean?
  clipStartMs    Int?
  clipEndMs      Int?
  payload        Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // C09 (CV11): the event's clip, once cut.
  clip Clip?

  @@unique([organisationId, id])
  @@unique([jobId, sourceKey])
  @@index([organisationId, matchId, status])
  @@index([trackId])
  @@index([playerId])
}

// C09 (CV05): where a calibration came from. `auto` is reserved for a later
// automatic estimator (Q-042); v0 writes fallback and manual.
enum CalibrationSource {
  fallback
  auto
  manual
}

// C09: where a Lab ground-truth tag came from. SoccerNet labels are for
// benchmarking only and never shipped (LICENSES.md).
enum BenchmarkTagSource {
  hand
  synthetic
  soccernet
}

// C09 (CV05, Q-042): a homography from video pixels to pitch metres (105 x 68,
// camera-fixed: x = 0 at the goal on the camera's left, y = 0 on the near
// touchline, Q-043). A manual one is reused for later matches of the
// organisation at the same venue and camera; at most one current manual per
// (organisationId, venueKey, cameraKey): partial unique
// "PitchCalibration_current_manual_key". Fallback ones belong to their video
// only. CHECK "PitchCalibration_confidence_range" in raw SQL.
model PitchCalibration {
  id                 String            @id @default(cuid())
  organisationId     String
  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  // Lower-cased, trimmed, whitespace-collapsed Match.venue; null: never reused.
  venueKey           String?
  // "{width}x{height}" of the probed video.
  cameraKey          String
  // 3 x 3, video pixels to pitch metres.
  homography         Json
  imageWidth         Int
  imageHeight        Int
  confidence         Float
  source             CalibrationSource
  // Manual only: how many landmarks were placed, and the RMS error in metres.
  pointCount         Int?
  reprojectionErrorM Float?
  // Plain columns, no relation: the calibration outlives the video and the user.
  sourceVideoId      String?
  calibratedByUserId String?
  supersededAt       DateTime?
  createdAt          DateTime          @default(now())

  videos Video[]

  @@unique([organisationId, id])
  // Written as Postgres stores it, so migrate diff stays empty.
  @@unique([organisationId, venueKey, cameraKey], map: "PitchCalibration_current_manual_key", where: raw("((\"supersededAt\" IS NULL) AND (source = 'manual'::\"CalibrationSource\") AND (\"venueKey\" IS NOT NULL))"))
  @@index([organisationId, venueKey, cameraKey])
}

// C09 (CV11): one clip per event, cut from the raw footage by the clips job
// (src/worker/clips.ts) to orgs/{org}/matches/{match}/clips/{eventId}.mp4.
// baseExpiresAt is Video.uploadedAt + 14 days and never changes; expiresAt is
// null while any ClipFavourite exists and baseExpiresAt otherwise, kept by
// the ClipFavourite triggers (raw SQL). C17 deletes the file at expiresAt and
// sets deletedAt; the row and its event stay. CHECKs "Clip_window" and
// "Clip_size_nonneg"; partial index "Clip_expiry_idx" for C17's sweep.
model Clip {
  id              String         @id @default(cuid())
  organisationId  String
  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId         String
  match           Match          @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  // One clip per event: @@unique([organisationId, eventId]).
  eventId         String
  event           Event          @relation(fields: [organisationId, eventId], references: [organisationId, id], onDelete: Cascade)
  // The clips job that cut it. Jobs only go with their match, which cascades
  // the clips first (as Event.job).
  processingJobId String?
  processingJob   ProcessingJob? @relation(fields: [organisationId, processingJobId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  blobPath        String
  // Video milliseconds.
  startMs         Int
  endMs           Int
  sizeBytes       BigInt
  width           Int
  height          Int
  baseExpiresAt   DateTime
  expiresAt       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  favourites ClipFavourite[]

  @@unique([organisationId, id])
  @@unique([organisationId, eventId])
  @@index([organisationId, matchId])
  @@index([expiresAt], map: "Clip_expiry_idx", where: raw("(\"deletedAt\" IS NULL)"))
}

// C09 (CV11), for C11 and C13: a user's favourite clip. organisationId is the
// clip's organisation, which may differ from a favouriting scout's. Any
// favourite clears Clip.expiresAt and removing the last restores it (triggers
// "ClipFavourite_after_insert" and "ClipFavourite_after_delete"); a clip whose
// file is deleted cannot be favourited ("ClipFavourite_before_insert"). Write
// through src/server/clips/favourites.ts.
model ClipFavourite {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  clipId         String
  clip           Clip         @relation(fields: [organisationId, clipId], references: [organisationId, id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([clipId, userId])
  @@unique([organisationId, id])
  @@index([userId])
}

// C09 (Q-046): the Lab's ground truth, hand-tagged (or synthetic or
// SoccerNet) events of a match, imported as CSV (src/server/lab/tags.ts).
// Times are video ms. CHECK "BenchmarkTag_time_nonneg" in raw SQL.
model BenchmarkTag {
  id              String             @id @default(cuid())
  organisationId  String
  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  matchId         String
  match           Match              @relation(fields: [organisationId, matchId], references: [organisationId, id], onDelete: Cascade)
  type            EventType
  timestampMs     Int
  teamSide        TeamSide?
  onTarget        Boolean?
  source          BenchmarkTagSource
  importBatchId   String
  // A plain column, no relation.
  createdByUserId String?
  createdAt       DateTime           @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, matchId, type])
}

enum GpuInstanceStatus {
  requested
  running
  destroying
  destroyed
  failed_to_start
}

// One GPU instance per CV attempt (NFR04, NFR07). Refused by the scoped client
// (cost is internal); read and written through src/server/cv/. processingJobId
// and matchId are plain columns, so the row and its cost outlive a match
// deletion and the watchdog still sees it. CHECK "GpuInstance_cost_nonneg" in
// raw SQL.
model GpuInstance {
  id                 String            @id @default(cuid())
  organisationId     String
  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  processingJobId    String
  matchId            String
  attempt            Int
  provider           String
  providerInstanceId String?
  status             GpuInstanceStatus @default(requested)
  requestedAt        DateTime          @default(now())
  startedAt          DateTime?
  lastHeartbeatAt    DateTime?
  // What the worker reported: succeeded or failed.
  resultStatus       String?
  resultAt           DateTime?
  // Redacted, at most 500 characters.
  resultError        String?
  resultSha256       String?
  // When the job this instance served settled, for the 30-minute rule.
  jobSettledAt       DateTime?
  destroyedAt        DateTime?
  // job_done | attempt_failed | idle | outlived | orphan | job_gone | start_failed
  destroyReason      String?
  centsPerHour       Int
  // ISO 4217.
  currency           String
  billedSeconds      Int?
  costCents          Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([processingJobId, attempt])
  @@unique([organisationId, id])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Plans, entitlements and usage (BILL01, BILL02, ADMIN04, ADMIN05, NFR04)
// ---------------------------------------------------------------------------

// Global. limits is a JSON map keyed by the registry keys in
// src/lib/entitlement-keys.ts: a limit is a non-negative integer or
// "unlimited", a feature is a boolean. A key the plan lacks falls back to the
// registry. Only the pilot plan exists in v0 (seeded by the c03 migration).
model Plan {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  priceCents Int      @default(0)
  // ISO 4217.
  currency   String   @default("ZAR")
  limits     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  // Data is never deleted when a subscription lapses; it becomes read-only (V201).
  lapsed
}

// One per organisation. A plan change updates the row and is audited; the
// history lives in AuditLog. provider and providerRef stay null until V201.
model Subscription {
  id               String             @id @default(cuid())
  organisationId   String             @unique
  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus @default(active)
  provider         String?
  providerRef      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([organisationId, id])
}

enum EntitlementSource {
  // A per-organisation limit (or add-on) that beats the plan.
  override
  // A per-organisation feature flag: the last word (ADMIN04).
  flag
}

// Per-organisation overrides and feature flags, resolved over the plan by
// src/server/entitlements/resolve.ts. key is a plain string, not an enum, so a
// new registry key needs no migration. value is JSON in the registry's shape.
// reason is a platform admin's internal note. setByUserId is a plain column with
// no User relation, so the row never reaches a user record.
model Entitlement {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key            String
  source         EntitlementSource
  value          Json
  reason         String?
  setByUserId    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organisationId, key, source])
  @@unique([organisationId, id])
}

enum UsageMetric {
  matches
  // Minutes are stored as seconds and shown as minutes (C18).
  video_seconds
  // In cents of the currency the provider bills; see UsageEvent.currency.
  gpu_cost_cents
  storage_bytes
}

// The usage meter (ADMIN05, NFR04): one signed delta per source. Storage
// deletions are negative rows, so current storage is the sum. Written only by
// recordUsage() (src/server/usage/meter.ts); the unique key makes a retried job
// count once (NFR06).
model UsageEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  metric         UsageMetric
  quantity       BigInt
  // ISO 4217, gpu_cost_cents only.
  currency       String?
  // What produced the usage, e.g. "Match" or "CvJob", and its id.
  sourceType     String
  sourceId       String
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([organisationId, metric, sourceType, sourceId])
  @@unique([organisationId, id])
  @@index([organisationId, metric, occurredAt])
}

// ---------------------------------------------------------------------------
// Audit (AUTH-07, NFR-20)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(cuid())
  // Null for platform-level events such as a login, which belong to a user,
  // not an organisation.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
}
