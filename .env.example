# Copy to .env (`make env` does this) and fill in. Never commit .env.
# Values here are local-development defaults only.

# --- App ---
APP_URL=http://wideline.localhost
NODE_ENV=development
LOG_LEVEL=info

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_USER=wideline
POSTGRES_PASSWORD=wideline-dev-only
POSTGRES_DB=wideline

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://wideline.localhost
# Google sign-in is enabled only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HMAC key for scout ID and passport numbers (only a keyed hash is stored).
# Required in production. Generate with: openssl rand -hex 32
ID_HASH_SECRET=

# --- Email (Mailpit locally; inbox at http://mail.wideline.localhost) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Wideline <no-reply@wideline.localhost>"

# --- Object storage (S3 API; RustFS locally, Hetzner Object Storage later) ---
S3_BUCKET=wideline
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=wideline-dev
S3_SECRET_ACCESS_KEY=wideline-dev-secret
# Public endpoint: presigned URLs are signed for this host, so browsers and
# workers must reach it under the same name.
S3_PUBLIC_ENDPOINT=http://s3.wideline.localhost
# Server-side endpoint for direct calls from inside the compose network.
S3_INTERNAL_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# --- Playback and transcode (C07) ---
# Seconds a presigned HLS segment URL lasts (default 60).
HLS_SEGMENT_URL_TTL_SEC=60
# Where ffmpeg writes the ladder before upload; empty uses the OS temp dir.
# Needs about twice the HLS size free (around 6 GB for a 90-minute match).
TRANSCODE_TMP_DIR=

# --- CV worker ---
# Shared secret for HMAC-signed worker callbacks. openssl rand -hex 32
CV_CALLBACK_SECRET=change-me
# docker (local containers) | hourly (the GPU provider, still to choose; a stub)
CV_DISPATCH=docker
# Where a CV instance calls back (C08). Locally the web service on the compose network.
# CV_CALLBACK_BASE_URL=http://web:3000
# CV_WORKER_IMAGE=wideline-cv-worker:dev
# CV_DOCKER_NETWORK=wideline_default
# Longest one CV attempt may run, in seconds (default 4 h).
# CV_MAX_JOB_SECONDS=14400
# CV jobs one dispatcher runs at once.
# CV_CONCURRENCY=2
# C09: synthetic (default; a generated scene, no GPU) | model (RF-DETR; needs the
# GPU image, blocker B-001). model with CV_DISPATCH=docker also needs
# CV_ALLOW_LOCAL_MODEL=1 (slow CPU experiments only).
# CV_PIPELINE_MODE=synthetic
# CV_ALLOW_LOCAL_MODEL=0
# The synthetic scene's seed (default 7, the golden fixture's).
# CV_SYNTHETIC_SEED=7
# The hourly GPU provider, once chosen (Q-033).
# HOURLY_GPU_API_URL=
# HOURLY_GPU_API_TOKEN=
# HOURLY_GPU_CENTS_PER_HOUR=
# HOURLY_GPU_CURRENCY=USD

# --- Transcode worker (optional; compose defaults shown) ---
# ffmpeg thread cap, and the worker container's memory limit.
# TRANSCODE_THREADS=2
# TRANSCODE_MEM_LIMIT=2g
# C09: ffmpeg processes one clips job runs at once.
# CLIPS_CONCURRENCY=2

# --- Seed ---
SEED_ADMIN_EMAIL=admin@wideline.localhost
# Leave empty to generate one; it is printed by `make seed`.
SEED_ADMIN_PASSWORD=

# --- Sentry (off unless set) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
