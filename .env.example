# Copy to .env (`make env` does this) and fill in. Never commit .env.
# Values here are local-development defaults only.

# --- App ---
APP_URL=http://wideline.localhost
NODE_ENV=development
LOG_LEVEL=info

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_USER=wideline
POSTGRES_PASSWORD=wideline-dev-only
POSTGRES_DB=wideline

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://wideline.localhost
# Google sign-in is enabled only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HMAC key for scout ID and passport numbers (only a keyed hash is stored).
# Required in production. Generate with: openssl rand -hex 32
ID_HASH_SECRET=

# --- Email (Mailpit locally; inbox at http://mail.wideline.localhost) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Wideline <no-reply@wideline.localhost>"

# --- Object storage (S3 API; RustFS locally, Hetzner Object Storage later) ---
S3_BUCKET=wideline
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=wideline-dev
S3_SECRET_ACCESS_KEY=wideline-dev-secret
# Public endpoint: presigned URLs are signed for this host, so browsers and
# workers must reach it under the same name.
S3_PUBLIC_ENDPOINT=http://s3.wideline.localhost
# Server-side endpoint for direct calls from inside the compose network.
S3_INTERNAL_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# --- CV worker ---
# Shared secret for HMAC-signed worker callbacks. openssl rand -hex 32
CV_CALLBACK_SECRET=change-me
# docker | subprocess
CV_DISPATCH=docker

# --- Seed ---
SEED_ADMIN_EMAIL=admin@wideline.localhost
# Leave empty to generate one; it is printed by `make seed`.
SEED_ADMIN_PASSWORD=

# --- Sentry (off unless set) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
