# Production settings for docker-compose.prod.yml (DEPLOY.md). Copy to
# .env.production on the server and fill in. Never commit .env.production.
# Placeholders only: every <...> must be replaced.
#
# Set in docker-compose.prod.yml, not here: DATABASE_URL, S3_INTERNAL_ENDPOINT,
# S3_FORCE_PATH_STYLE (they follow the stack's own services).

# --- Server ---
# The server's sslip.io suffix: the public IP with dashes. The URLs below are
# built from it (compose expands ${...} in this file).
SSLIP_HOST=<1-2-3-4>.sslip.io
NODE_ENV=production
LOG_LEVEL=info
APP_URL=https://wideline.${SSLIP_HOST}
BETTER_AUTH_URL=https://wideline.${SSLIP_HOST}

# --- Resources (shared server: keep low) ---
# ffmpeg threads and the transcode worker's memory cap.
TRANSCODE_THREADS=2
TRANSCODE_MEM_LIMIT=2g
WEB_MEM_LIMIT=1g
CLIPS_CONCURRENCY=2

# --- Database ---
POSTGRES_USER=wideline
# openssl rand -hex 24
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=wideline

# --- Auth (Better Auth) ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=<generate>
# Google sign-in is enabled only when both are set. The OAuth redirect URI is
# https://wideline.$SSLIP_HOST/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keys the scout ID hash. Required: the app refuses to start in production
# without it (at least 32 characters). Never change it once set.
# openssl rand -hex 32
ID_HASH_SECRET=<generate>

# --- Email ---
# Mailpit in this stack catches everything (https://mail.wideline.$SSLIP_HOST)
# until there is a real SMTP provider; then point these at it.
SMTP_HOST=wideline-mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Wideline <no-reply@wideline.${SSLIP_HOST}>"

# --- Object storage (RustFS in this stack) ---
# Presigned URLs are signed for this host; it must be what browsers and
# containers use (Caddy, with a network alias on `edge` for containers).
S3_PUBLIC_ENDPOINT=https://s3.wideline.${SSLIP_HOST}
S3_BUCKET=wideline
S3_REGION=us-east-1
# Also RustFS's root credentials. openssl rand -hex 12 / openssl rand -hex 24
S3_ACCESS_KEY_ID=<generate>
S3_SECRET_ACCESS_KEY=<generate>
HLS_SEGMENT_URL_TTL_SEC=60

# --- CV (off) ---
# The code supports docker (needs the Docker socket, which production does not
# have) and hourly (a stub until C19, Q-033). hourly passes validation; the
# stack runs no cv-dispatcher, so CV jobs stay queued and matches stay in
# Processing after transcode. Playback works.
CV_DISPATCH=hourly
CV_CALLBACK_BASE_URL=https://wideline.${SSLIP_HOST}
# Required by the app even with CV off: at least 32 characters in production.
# openssl rand -hex 32
CV_CALLBACK_SECRET=<generate>

# --- Seed (one-time; see DEPLOY.md) ---
SEED_ADMIN_EMAIL=<admin@example.com>
# Leave empty to generate one; the seed prints it.
SEED_ADMIN_PASSWORD=

# --- Sentry (off unless set) ---
SENTRY_DSN=
